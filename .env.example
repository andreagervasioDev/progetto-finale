# ------------------------------------------------------------------
# Copia questo file in ".env" (stessa cartella) e inserisci la tua chiave.
# Il file .env è escluso dal version control tramite .gitignore.
# ------------------------------------------------------------------

# --- OpenAI (obbligatoria) ---
OPENAI_API_KEY=sk-...
# modello usato dall'orchestratore Node e dal pandas agent Python
OPENAI_MODEL=gpt-4.1-mini
# (opzionale) modello diverso solo per il data agent
# DATA_AGENT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Backend Node.js ---
BACKEND_PORT=3002
CORS_ORIGIN=http://localhost:5173
MAX_AGENT_STEPS=6
MAX_HISTORY_MESSAGES=20

# --- Accesso ---
# password degli utenti creati al primo avvio (admin / test): cambiale prima di condividere l'app
DEFAULT_ADMIN_PASSWORD=admin
DEFAULT_TEST_PASSWORD=test
# (opzionale) chiave per firmare le sessioni; se manca viene generata in backend/storage/.auth_secret
# AUTH_SECRET=
SESSION_DAYS=7

# --- ChromaDB locale ---
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=management_ai_documents

# --- Data agent Python (FastAPI) ---
DATA_AGENT_URL=http://127.0.0.1:8001
DATA_AGENT_PORT=8001
DATA_AGENT_TIMEOUT_MS=180000
DATA_AGENT_MAX_STEPS=8
# sandbox dell'esecutore: tempo massimo (s) per ogni blocco di codice generato
DATA_AGENT_EXEC_TIMEOUT=15
