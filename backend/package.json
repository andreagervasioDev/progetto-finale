{
  "name": "management-ai-backend",
  "version": "1.0.0",
  "description": "Orchestratore Node.js: sessioni, function calling OpenAI, RAG con ChromaDB e delega al data agent Python",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "chroma": "chroma run --path ./chroma_data --port 8000",
    "ingest": "node src/rag/ingest.js",
    "ingest:reset": "node src/rag/ingest.js --reset",
    "test": "node --test \"tests/*.test.js\""
  },
  "license": "ISC",
  "dependencies": {
    "chromadb": "^3.5.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "openai": "^7.23.0",
    "pdf-parse": "^2.4.5",
    "sanitize-html": "^2.18.1"
  },
  "overrides": {
    "argparse": "2.0.1"
  }
}
